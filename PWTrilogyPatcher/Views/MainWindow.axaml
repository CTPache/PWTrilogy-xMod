<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PWTrilogyPatcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PWTrilogyPatcher.Views"
        x:Class="PWTrilogyPatcher.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
		WindowStartupLocation="CenterScreen"
		Width="1258" Height="668"
		CanResize="False">
	<Panel>
		<ContentControl Content="{Binding ContentViewModel}"/>

		<!-- Selector de idioma en esquina superior derecha -->
		<Border HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Margin="0,14,20,0"
				Background="#D0000000"
				CornerRadius="6"
				Padding="6,4">
			<StackPanel Orientation="Horizontal" Spacing="6">
				<TextBlock Text="🌐"
						   FontSize="14"
						   VerticalAlignment="Center"
						   Foreground="White"/>
				<ComboBox SelectedIndex="{Binding SelectedLanguageIndex}"
						  ItemsSource="{Binding AvailableLanguages}"
						  FontFamily="{StaticResource GameFont}"
						  FontSize="13"
						  Width="180"
						  Height="30"
						  VerticalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Panel>
</Window>
